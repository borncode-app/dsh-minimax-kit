{
  "name": "@local/dsh-minimax-credit",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Shows the account's remaining MiniMax credits and keeps the MiniMax provider working after the Token Plan quota is spent.",
  "author": "BornCode (https://github.com/borncode-app)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/borncode-app/dsh-minimax-credit.git"
  },
  "homepage": "https://github.com/borncode-app/dsh-minimax-credit#readme",
  "bugs": {
    "url": "https://github.com/borncode-app/dsh-minimax-credit/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "minimax",
    "proxy",
    "credits",
    "quota",
    "anthropic-messages"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0",
    "@local/dsh-minimax-auth": "github:borncode-app/dsh-minimax-auth#b187c15ece564e1e7a81512d857853ee711eda79"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
