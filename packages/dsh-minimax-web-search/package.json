{
    "name":  "@local/dsh-minimax-web-search",
    "version":  "1.0.0",
    "private":  true,
    "type":  "module",
    "description":  "Web search for DeepSeek Harness through MiniMax's native web_search server tool, with a credit failover when the Token Plan quota is spent.",
    "author":  "BornCode (https://github.com/borncode-app)",
    "license":  "MIT",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/borncode-app/dsh-minimax-kit.git"
                   },
    "homepage":  "https://github.com/borncode-app/dsh-minimax-kit#readme",
    "bugs":  {
                 "url":  "https://github.com/borncode-app/dsh-minimax-kit/issues"
             },
    "keywords":  [
                     "dsh",
                     "deepseek-harness",
                     "dsh-plugin",
                     "minimax",
                     "web-search",
                     "search"
                 ],
    "exports":  {
                    ".":  "./index.js",
                    "./locale/*.json":  "./locale/*.json",
                    "./icon":  "./icon.svg"
                },
    "files":  [
                  "index.js",
                  "cordis.patch.yml",
                  "locale/*.json",
                  "icon.svg",
                  "README.md",
                  "LICENSE"
              ],
    "scripts":  {
                    "test":  "node --test"
                },
    "dependencies":  {
                         "@deepseek-ai/schemastery":  "~3.19.0",
                         "@local/dsh-minimax-auth":  "link:../dsh-minimax-auth"
                     },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           }
            }
}
